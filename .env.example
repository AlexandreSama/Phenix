# Copiez ce fichier en .env pour le développement local : cp .env.example .env

# MySQL (root en local : prisma migrate dev doit créer une base temporaire)
MYSQL_ROOT_PASSWORD=change-moi
DATABASE_URL=mysql://root:change-moi@localhost:3306/phenix

# Redis
REDIS_URL=redis://localhost:6379

# Discord (application de dev, sur https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Serveur de test : les commandes y sont publiées instantanément
DISCORD_DEV_GUILD_ID=

# SeaweedFS (identiques à docker/seaweedfs/s3.json)
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=phenix-dev
S3_SECRET_KEY=
S3_BUCKET=phenix

# Chiffrement des tokens OAuth : openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# API et panel
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
