{
  "name": "@phenix/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "commands:deploy": "tsx --env-file=../../.env src/deploy-commands.ts",
    "lint": "oxlint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@phenix/database": "workspace:*",
    "@phenix/shared": "workspace:*",
    "bullmq": "catalog:",
    "discord.js": "^14.27.0",
    "ioredis": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "^1.58.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  }
}
