# Copiez ce fichier en .env.production sur le serveur. Ne le commitez jamais.
# DATABASE_URL, REDIS_URL et S3_ENDPOINT sont fournis par docker/compose.prod.yml.

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Discord (application de prod)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# SeaweedFS (identiques à docker/seaweedfs/s3.prod.json)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=phenix

# Chiffrement des tokens OAuth : openssl rand -base64 32
# Le changer rend illisibles les tokens déjà stockés : les utilisateurs devront se reconnecter
TOKEN_ENCRYPTION_KEY=

# API et panel
API_PORT=3001
# Adresse publique du panel ; la redirection OAuth2 de Discord est WEB_ORIGIN/api/auth/callback
WEB_ORIGIN=https://panel.example.com
